{
  "name": "chenhun-planner",
  "version": "1.0.0",
  "description": "晨昏日程 · 每天的学习、课程、任务与省钱计划",
  "main": "main.js",
  "author": "Laity206",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.laity206.chenhun",
    "productName": "晨昏日程",
    "copyright": "Copyright © 2026 Laity206",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ChenhunPlanner",
      "signAndEditExecutable": false,
      "sign": null
    },
    "portable": {
      "artifactName": "ChenhunPlanner-${version}-portable.exe",
      "requestExecutionLevel": "user"
    }
  }
}
